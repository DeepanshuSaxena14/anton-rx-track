# --- Anton RX Track: Core Environment Variables ---
# Copy this file to .env and fill in the values

# Server Settings
PORT=8000
ENVIRONMENT=development

# P1: AI Models & LLM configuration
OPENAI_API_KEY=your_openai_key_here
LLM_FALLBACK_PROVIDER=anthropic  # e.g., anthropic, cohere

# P2: DB & Storage configuration
DATABASE_URL=postgres://user:pass@host:5432/db
S3_BUCKET_NAME=anton-rx-track-pdfs
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx

# P3/P4: Demo Overrides
USE_LOCAL_DEMO_DATA=True # Set to True to skip DB for demo stability
